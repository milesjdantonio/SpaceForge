# Local development only. Keep this file free of real credentials.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://spaceforge:spaceforge_local@127.0.0.1:5432/spaceforge?sslmode=disable
DB_MAX_CONNS=5
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=demo-spaceforge
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Used only by the design service (design-service/). Source .env in its terminal too.
# Alternatively put the raw Gemini key in root APIKey.txt (ignored by Git).
GEMINI_API_KEY=

# Enable server-owned generation by setting the URL and a random shared token.
# Generate the token once with: openssl rand -hex 32
# Both the API and housecost processes need the same GENERATION_SERVICE_TOKEN.
# Leaving GENERATION_URL empty keeps auth, projects and saved buildings available.
GENERATION_URL=
GENERATION_SERVICE_TOKEN=
GENERATION_WORKERS=2
