 "housingType": "house",
 "overview": {
  "title": "The Bank Gable House",
  "summary": "A farmhouse house turned to the south, with 4 bedrooms on a 23,814 sq ft lot.",
  "description": [
   "The Bank Gable House is a 2-storey farmhouse home of about 2,207 sq ft, with 4 bedrooms and 3 bathrooms, drawn for this 23,814 sq ft site. Steep gables, board-and-batten, a deep porch.",
   "The plan turns its long side to the south, so the rooms people use most get the best light, while the entry, stair and wet rooms form a quiet back zone. Board-and-batten siding and standing-seam metal were chosen for a hot-humid climate."
  ],
  "siteResponse": [
   "Living, dining and the primary bedroom face south for low winter sun; the hall and service rooms take the north side.",
   "The house sits at the back of a 147 ft by 121 ft buildable area, leaving the garden on the sunny side of a 23,814 sq ft lot.",
   "The ground falls 11% toward the southwest; the foundation steps with it instead of flattening the site.",
   "Heat and humidity: shaded porches, raised floors, moisture-tolerant materials.",
   "The 2-car garage closes the west end and shelters the entry."
  ],
  "features": [
   "Covered porch at the entry",
   "Heat-pump heating and cooling, triple glazing, solar-ready roof",
   "A study by the entry for working from home",
   "Stacked stair with a window on the landing",
   "Gable roof with trim eaves"
  ],
  "cautions": [
   "Slope and soil are simulated until a survey and real terrain data are attached.",
   "Check local zoning for setbacks, height limits and lot coverage before publishing."
  ],
  "style": "farmhouse"
 },
